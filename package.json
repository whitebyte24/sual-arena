    "content:build:dev": "tsx scripts/build-content.ts --dev",
    "postinstall": "npm run content:build",
    "i18n:hardcoded": "tsx scripts/check-hardcoded.ts",
    "content:sheet": "tsx scripts/content-sheet.ts",
    "content:apply": "tsx scripts/content-apply.ts",
