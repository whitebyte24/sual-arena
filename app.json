{
  "expo": {
    "name": "Sual Arena",
    "slug": "sual-arena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sualarena.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1B33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.sualarena.app",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Sana daha uygun reklamlar gösterebilmemiz için cihaz kimliğini kullanmamıza izin verebilirsin. İzin vermezsen reklamlar yine görünür ama kişiselleştirilmez."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Sana daha uygun reklamlar gösterebilmemiz için cihaz kimliğini kullanmamıza izin verebilirsin. İzin vermezsen reklamlar yine görünür ama kişiselleştirilmez."
        }
      ],
      "expo-apple-authentication",
      "expo-dev-client",
      "expo-font",
      "expo-splash-screen"
    ],
    "scheme": "sualarena",
    "backgroundColor": "#0B1B33",
    "experiments": {
      "typedRoutes": true
    }
  }
}
